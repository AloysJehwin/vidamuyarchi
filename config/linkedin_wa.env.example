# WhatsApp Cloud API config for the LinkedIn daily runner.
# Copy to ~/.linkedin_wa.env and fill in the three values, then chmod 600.
# The runner reads this to POST a daily summary to your WhatsApp.
#
# WHERE TO FIND THESE (Meta for Developers → your app
# → WhatsApp → API Setup):
#   WA_TOKEN     = the temporary access token shown on the API Setup page
#                  (test tokens expire ~24h — for daily use, generate a
#                   permanent System User token instead)
#   WA_PHONE_ID  = the "Phone number ID" on that same page (NOT the phone number)
#   WA_TO        = YOUR WhatsApp number as recipient, country code, no plus sign
#                  e.g. an Indian number → 9198XXXXXXXX
#                  (must be added as a verified recipient in the test setup)

WA_TOKEN=
WA_PHONE_ID=
WA_TO=
